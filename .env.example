# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/leadscout

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
# Comma-separated frontend origins allowed to call this API.
# Wildcards are supported: https://leadscout-*.vercel.app
CLIENT_URL=http://localhost:5173
# Vercel preview deployments are allowed by default. Set to false to allow
# only the exact origins listed above (recommended once custom domains settle).
ALLOW_VERCEL_PREVIEWS=true
NODE_ENV=development

# ── Clerk auth ────────────────────────────────────────────────────────────────
# Dashboard → API keys
CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
# Dashboard → Webhooks → endpoint https://your-api/api/webhooks/clerk
# Required for profile updates + account-deletion cleanup. Optional in dev.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_signing_secret

# ── Discovery providers (optional) ────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=

# ── Redis (optional; only needed if you enable the BullMQ queue) ──────────────
REDIS_URL=
